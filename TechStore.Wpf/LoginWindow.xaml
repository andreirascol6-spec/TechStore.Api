<Window x:Class="TechStore.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechStore.Wpf"
        mc:Ignorable="d"
        Title="Autentificare - TechStore" 
        Height="480" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">
        <Border Background="White" 
                CornerRadius="8" 
                Margin="30" 
                Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="Gray" Opacity="0.2" Direction="270"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">

                <!-- Titlu -->
                <TextBlock Text="TechStore Auth" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Foreground="#333333" 
                           Margin="0,0,0,15"/>

                <!-- TextBlock pentru Afișare Erori -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="Red" 
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Username (Legat la proprietatea Username) -->
                <TextBlock Text="Username" 
                           FontWeight="SemiBold" 
                           Foreground="#555555" 
                           Margin="0,0,0,5"/>
                <TextBox x:Name="TxtUsername" 
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="35" 
                         Padding="5" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,15"/>

                <!-- Parolă (Identificată prin x:Name="TxtPassword") -->
                <TextBlock Text="Parolă" 
                           FontWeight="SemiBold" 
                           Foreground="#555555" 
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" 
                             Height="35" 
                             Padding="5" 
                             VerticalContentAlignment="Center" 
                             Margin="0,0,0,20"/>

                <!-- Buton Login (Legat la LoginCommand și trimite TxtPassword ca parametru) -->
                <Button Content="Autentificare" 
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=TxtPassword}"
                        Height="38" 
                        Background="#007ACC" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="14"
                        Margin="0,0,0,10"/>

                <!-- Buton Register (Legat la RegisterCommand și trimite TxtPassword ca parametru) -->
                <Button Content="Creează cont nou (Register)" 
                        Command="{Binding RegisterCommand}" 
                        CommandParameter="{Binding ElementName=TxtPassword}"
                        Height="32" 
                        Background="Transparent" 
                        BorderBrush="#007ACC" 
                        Foreground="#007ACC"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>